트리뷰트(Attribute)가 취할 수 있는 모든 원자값들의 집합을 무엇이라고 하는가?"}],"options":[{"no":1,"text":"도메인","refs":[149,175]},{"no":2,"text":"스키마","refs":[175,143]},{"no":3,"text":"튜플","refs":[147,150]},{"no":4,"text":"엔티티","refs":[149]}],"page":4,"answer":1,"exam":"2023-3","qid":"2023-3-49","subjectNo":3,"refs":[149,175,165],"unit":"DB 설계·데이터 모델"},{"no":50,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"데이터베이스 관리 시스템(DBMS)의 필수 기능이 아닌 것은?"}],"options":[{"no":1,"text":"제어 기능","refs":[80,31]},{"no":2,"text":"조작 기능","refs":[184,177]},{"no":3,"text":"정의 기능","refs":[94,6]},{"no":4,"text":"운영 기능","refs":[5,4]}],"page":4,"answer":4,"exam":"2023-3","qid":"2023-3-50","subjectNo":3,"refs":[142,143,177],"unit":"DB 설계·데이터 모델"},{"no":51,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"릴레이션의 기본키를 구성하는 어떤 속성도 널(Null) 값이나 중복 값을 가질 수 없음을 의미하는 것은?"}],"options":[{"no":1,"text":"참조 무결성 제약 조건","refs":[157,145]},{"no":2,"text":"정보 무결성 제약 조건","refs":[157,145]},{"no":3,"text":"개체 무결성 제약 조건","refs":[157,145]},{"no":4,"text":"주소 무결성 제약 조건","refs":[157,145]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-51","subjectNo":3,"refs":[157,150,156],"unit":"키·무결성"},{"no":52,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"DCL(Data Control Language) 명령어가 아닌 것은?"}],"options":[{"no":1,"text":"COMMIT","refs":[177,174]},{"no":2,"text":"ROLLBACK","refs":[177,174]},{"no":3,"text":"GRANT","refs":[177]},{"no":4,"text":"SELECT","refs":[185,159]}],"page":4,"answer":4,"exam":"2023-3","qid":"2023-3-52","subjectNo":3,"refs":[177,185,159],"unit":"SQL"},{"no":53,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"학생(STUDENT) 테이블에 컴퓨터정보과 학생 120명, 인터넷정보과 학생 160명, 사무자동화과 학생 80명에 관한 데이터가 있다고 했을 때, 다음에 주어지는 SQL문 ㉠, ㉡, ㉢을 각각 실행 시키면, 결과 튜플 수는 각각 몇 개인가? (단, DEPT는 학과 컬럼명임)"},{"type":"code","lines":["㉠ SELECT DISTINCT DEPT FROM STUDENT;","㉡ SELECT DEPT FROM STUDENT;","㉢ SELECT COUNT(DISTINCT DEPT) FROM STUDENT","WHERE DEPT = ‘컴퓨터정보과’;"],"indents":[5.2,5.2,5.2,18.5]}],"options":[{"no":1,"text":"㉠ 3, ㉡ 360, ㉢ 1","refs":[185]},{"no":2,"text":"㉠ 360, ㉡ 3, ㉢ 120","refs":[185]},{"no":3,"text":"㉠ 3, ㉡ 360, ㉢ 120","refs":[185]},{"no":4,"text":"㉠ 360, ㉡ 3, ㉢ 1","refs":[185]}],"page":4,"answer":1,"exam":"2023-3","qid":"2023-3-53","subjectNo":3,"refs":[185,182,184],"unit":"SQL"},{"no":54,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"트랜잭션(Transaction)의 특성에 해당하지 않는 것은?"}],"options":[{"no":1,"text":"Atomicity","refs":[174]},{"no":2,"text":"Consistency","refs":[174]},{"no":3,"text":"Isolation","refs":[174]},{"no":4,"text":"Distribution","refs":[174]}],"page":4,"answer":4,"exam":"2023-3","qid":"2023-3-54","subjectNo":3,"refs":[174,143,144],"unit":"뷰·카탈로그·트랜잭션"},{"no":55,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"릴레이션 R의 튜플의 개수가 4, 릴레이션 S의 튜플의 개수가 5일 때, 두 릴레이션을 카티션 프로덕트(Cartesian Product)한 결과 릴레 이션의 카디널리티는?"}],"options":[{"no":1,"text":"1","refs":[150]},{"no":2,"text":"9","refs":[150]},{"no":3,"text":"20","refs":[150]},{"no":4,"text":"41","refs":[150]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-55","subjectNo":3,"refs":[150,164,156],"unit":"DB 설계·데이터 모델"},{"no":56,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"데이터베이스의 무결성 규정(Integrity Rule)과 관련한 설명으로 틀린 것은?"}],"options":[{"no":1,"text":"무결성 규정에는 데이터가 만족해야 될 제약 조건, 규정을 참조 할 때 사용하는 식별자 등의 요소가 포함될 수 있다.","refs":[157,145]},{"no":2,"text":"무결성 규정의 대상으로는 도메인, 키, 종속성 등이 있다.","refs":[157,149]},{"no":3,"text":"정식으로 허가 받은 사용자가 아닌 불법적인 사용자에 의한 갱신으로부터 데이터베이스를 보호하기 위한 규정이다.","refs":[177,142]},{"no":4,"text":"릴레이션 무결성 규정(Relation Integrity Rules)은 릴레이션을 조작하는 과정에서의 의미적 관계(Semantic Relationship)를 명세한 것이다.","refs":[150,157]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-56","subjectNo":3,"refs":[177,143,142],"unit":"SQL"},{"no":57,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"가장 나중에 삽입된 자료가 가장 먼저 삭제되는 후입선출(LIFO; Last In First Out) 방식으로 자료를 처리하는 자료 구조는?"}],"options":[{"no":1,"text":"Queue","refs":[129]},{"no":2,"text":"Graph","refs":[132]},{"no":3,"text":"Stack","refs":[126]},{"no":4,"text":"Tree","refs":[132]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-57","subjectNo":3,"refs":[126,129,4],"unit":"자료구조"},{"no":58,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"키 값으로부터 주소 변환을 위해서 해시 함수나 색인 테이블을 사용하는 파일 구조는?"}],"options":[{"no":1,"text":"순차 파일","refs":[83,18]},{"no":2,"text":"분할 파일","refs":[83,18]},{"no":3,"text":"직접 파일","refs":[17,83]},{"no":4,"text":"색인 순차 파일","refs":[83,18]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-58","subjectNo":3,"refs":[83,17,18],"unit":"입·출력 함수"},{"no":59,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"데이터베이스 설계 단계 중 물리적 설계에 대한 설명으로 옳지 않은 것은?"}],"options":[{"no":1,"text":"개념적 설계 단계에서 만들어진 정보 구조로부터 특정 목표 DBMS가 처리할 수 있는 스키마를 생성한다.","refs":[143,166]},{"no":2,"text":"다양한 데이터베이스 응용에 대해서 처리 성능을 얻기 위해 데이터베이스 파일의 저장 구조 및 액세스 경로를 결정한다.","refs":[143,177]},{"no":3,"text":"물리적 저장장치에 저장할 수 있는 물리적 구조의 데이터로 변환하는 과정이다.","refs":[143,177]},{"no":4,"text":"물리적 설계에서 옵션 선택 시 응답시간, 저장 공간의 효율화, 트랜잭션 처리율 등을 고려하여야 한다.","refs":[174,144]}],"page":4,"answer":1,"exam":"2023-3","qid":"2023-3-59","subjectNo":3,"refs":[143,177,174],"unit":"DB 설계·데이터 모델"},{"no":60,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"관계 데이터베이스의 구성 요소에 대한 다음 설명 중 가장 옳지 않은 것은?"}],"options":[{"no":1,"text":"릴레이션은 식별자에 의해 식별이 가능해야 한다.","refs":[150,157]},{"no":2,"text":"속성은 릴레이션을 구성하는 항목이다.","refs":[150,155]},{"no":3,"text":"하나의 릴레이션을 구성하는 튜플은 모두 같다.","refs":[150,155]},{"no":4,"text":"각 속성은 릴레이션 내에서 유일한 이름을 가진다. 4 -","refs":[150,164]}],"page":4,"answer":3,"exam":"2023-3","qid":"2023-3-60","subjectNo":3,"refs":[150,161,151],"unit":"DB 설계·데이터 모델"}]}