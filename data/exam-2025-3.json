00);","console.log(r);","</script>","…생략…"],"indents":[5.0,5.0,13.0,13.0,21.2,21.2,29.2,21.2,13.0,13.0,5.0,5.0]}],"options":[{"no":1,"text":"㉠-do, ㉡-while","refs":[88,87]},{"no":2,"text":"㉠-do, ㉡-loop","refs":[88,57]},{"no":3,"text":"㉠-while, ㉡-do","refs":[88,87]},{"no":4,"text":"㉠-loop, ㉡-do","refs":[88,57]}],"page":3,"answer":1,"exam":"2025-3","qid":"2025-3-40","subjectNo":2,"refs":[88,87,84],"unit":"제어문·배열·포인터"},{"no":41,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"3, 5, 6, 8의 순서로 정해진 입력자료를 스택에 입력하였다가 출력한 결과가 될 수 없는 것은?(단, 왼쪽부터 먼저 출력된 순서이 다.)"}],"options":[{"no":1,"text":"6, 5, 3, 8","refs":[128]},{"no":2,"text":"6, 8, 3, 5","refs":[128]},{"no":3,"text":"5, 3, 8, 6","refs":[128]},{"no":4,"text":"5, 6, 8, 3","refs":[128]}],"page":3,"answer":2,"exam":"2025-3","qid":"2025-3-41","subjectNo":3,"refs":[128,83,96],"unit":"자료구조"},{"no":42,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"데이터베이스 설계 단계 중 물리적 설계에 대한 설명으로 옳지 않은 것은?"}],"options":[{"no":1,"text":"개념적 설계 단계에서 만들어진 정보 구조로부터 특정 목표 DBMS가 처리할 수 있는 스키마를 생성한다.","refs":[143,166]},{"no":2,"text":"다양한 데이터베이스 응용에 대해서 처리 성능을 얻기 위해 데이터베이스 파일의 저장 구조 및 액세스 경로를 결정한다.","refs":[143,177]},{"no":3,"text":"물리적 저장장치에 저장할 수 있는 물리적 구조의 데이터로 변환하는 과정이다.","refs":[143,177]},{"no":4,"text":"물리적 설계에서 옵션 선택 시 응답시간, 저장 공간의 효율화, 트랜잭션 처리율 등을 고려하여야 한다.","refs":[174,144]}],"page":3,"answer":1,"exam":"2025-3","qid":"2025-3-42","subjectNo":3,"refs":[143,177,174],"unit":"DB 설계·데이터 모델"},{"no":43,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"text","text":"시스템 카탈로그에 대한 설명으로 틀린 것은?"}],"options":[{"no":1,"text":"시스템 자신이 필요로 하는 스키마 및 여러 가지 객체에 관한 정보를 포함하고 있는 시스템 데이터베이스이다.","refs":[143,173]},{"no":2,"text":"시스템 카탈로그에 저장되는 내용을 메타 데이터라고 한다.","refs":[173,143]},{"no":3,"text":"데이터 사전이라고도 한다.","refs":[145,154]},{"no":4,"text":"일반 사용자는 시스템 테이블의 내용을 검색할 수 없다.","refs":[103,173]}],"page":3,"answer":4,"exam":"2025-3","qid":"2025-3-43","subjectNo":3,"refs":[173,143,177],"unit":"뷰·카탈로그·트랜잭션"},{"no":44,"subject":"제3과목 데이터베이스 활용","stem":[{"type":"tex